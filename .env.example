# Trackstr Environment Configuration

# Optional: TMDB API Key (Free Tier)
# Get a free key at: https://www.themoviedb.org/settings/api
# You can also enter this key directly in the Trackstr UI Settings modal
VITE_TMDB_API_KEY=

# Optional: Custom Originless IPFS Node URL
# Default public node: https://originless.gupt.app
VITE_ORIGINLESS_URL=https://originless.gupt.app
